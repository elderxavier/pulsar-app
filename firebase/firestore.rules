rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /posts/{postId} {
      // Qualquer pessoa pode LER posts que ainda não expiraram
      allow read: if request.time < resource.data.expiresAt;

      // Apenas usuários autenticados podem CRIAR posts
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 280
        && request.resource.data.expiresAt == request.resource.data.createdAt + duration.value(6, 'h');

      // Apenas o dono pode DELETAR o próprio post
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userId;

      // Ninguém pode editar posts após criação
      allow update: if false;
    }
  }
}
