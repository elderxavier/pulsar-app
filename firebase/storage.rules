rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ====================================================================
    // /posts/{userId}/{fileName}
    //   - Leitura: pública (posts são públicos no app)
    //   - Escrita: somente o dono, < 10MB, mime image/* ou video/*
    // ====================================================================
    match /posts/{userId}/{fileName} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
        );

      // Update bloqueado — mídia é imutável (nova mídia = novo objeto)
      allow update: if false;

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Avatares de usuário (mesmo padrão, namespace separado)
    match /users/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
